// backend/src/models/Vehicle.js
const mongoose = require('mongoose');

const VehicleSchema = new mongoose.Schema({
  userId: {
    type: mongoose.Schema.Types.ObjectId,
    ref: 'User',
    required: true,
  },
  make: {
    type: String,
    required: true,
  },
  model: {
    type: String,
    required: true,
  },
  year: Number,
  color: String,
  licensePlate: String,
  vin: {
    type: String,
    unique: true,
    sparse: true,
  },
  obdData: {
    lastReading: Date,
    speed: Number,
    rpm: Number,
    engineTemp: Number,
    fuelLevel: Number,
    tirePressure: [Number],
    batteryVoltage: Number,
    errorCodes: [{
      code: String,
      description: String,
      timestamp: Date,
    }],
  },
  diagnostics: {
    lastScan: Date,
    healthScore: {
      type: Number,
      min: 0,
      max: 100,
    },
    issues: [{
      severity: {
        type: String,
        enum: ['low', 'medium', 'high', 'critical'],
      },
      description: String,
      recommendedAction: String,
      estimatedCost: Number,
    }],
  },
  analytics: {
    averageSpeed: Number,
    totalMiles: Number,
    fuelEfficiency: Number,
    tripsCount: Number,
    hardBrakes: Number,
    rapidAccelerations: Number,
  },
  createdAt: {
    type: Date,
    default: Date.now,
  },
});

VehicleSchema.index({ userId: 1 });

module.exports = mongoose.model('Vehicle', VehicleSchema);
